{
  "name": "yeetkit",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "SolidJS + Tailwind apps that run inside a yeet isolate and render into the browser over the tty portal.",
  "type": "module",
  "bin": {
    "yeetkit": "./bin/yeetkit.mjs"
  },
  "exports": {
    ".": "./src/runtime/index.js",
    "./renderer": "./src/runtime/renderer.js",
    "./client.js": "./src/client/client.js",
    "./src/*": "./src/*"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "LICENSE"
  ],
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@tailwindcss/cli": "^4.0.0",
    "babel-preset-solid": "^1.9.0",
    "esbuild": "^0.28.0",
    "solid-js": "^1.9.0",
    "tailwindcss": "^4.0.0",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "jsdom": "^25.0.0"
  }
}
